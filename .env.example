# Copy this file to .env and fill in your local values.

# Required when scanning or browsing a local library.
MUSIC_DIR=
MUSIC_APP_DATA_DIR=
MUSIC_CACHE_PATH=
MUSIC_COVER_CACHE_PATH=
MUSIC_CACHE_MAX_AGE_SECONDS=300

MUSICBRAINZ_ENABLED=1
MUSICBRAINZ_CONTACT_EMAIL=your-email@example.com
# Optional override. Prefer leaving this unset so the app generates:
# AlbumHaven/<version> (Album Haven; your-email@example.com)
MUSICBRAINZ_USER_AGENT=

LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret

DISCOGS_CONSUMER_KEY=your_discogs_consumer_key
DISCOGS_CONSUMER_SECRET=your_discogs_consumer_secret

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=US

MUSIC_APP_DEBUG=0
MUSIC_APP_RELOADER=0

# Required for Phase 7 local authentication and one-time owner provisioning.
ALBUM_HAVEN_APP_DATABASE_URL=postgresql://album_haven_app@localhost:5432/album_haven_core
ALBUM_HAVEN_BOOTSTRAP_USERNAME=Rendref
ALBUM_HAVEN_BOOTSTRAP_EMAIL=
ALBUM_HAVEN_PUBLIC_BASE_URL=https://album-haven.example.com
# Generate a private random value containing at least 32 UTF-8 bytes.
ALBUM_HAVEN_AUTH_HMAC_SECRET=
ALBUM_HAVEN_AUTH_HMAC_KEY_VERSION=1

# Required only when test:e2e:performance includes the isolated scan targets.
# Provision dedicated test database roles before running scan performance checks.
# PGPASSFILE=<path-to-your-postgresql-pgpass-file>
# ALBUM_HAVEN_SCAN_PERFORMANCE_SETUP_DATABASE_URL=postgresql://album_haven_migrator@localhost:5432/album_haven_scan_e2e
# ALBUM_HAVEN_SCAN_PERFORMANCE_DATABASE_URL=postgresql://album_haven_app@localhost:5432/album_haven_scan_e2e
