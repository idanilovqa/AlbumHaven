<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <WebView
        android:id="@+id/shell_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas" />

    <ScrollView
        android:id="@+id/recovery_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/recovery_logo_description"
                android:src="@drawable/album_haven_logo" />

            <LinearLayout
                android:id="@+id/recovery_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/RecoveryTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/recovery_loading_title" />

                <TextView
                    android:id="@+id/recovery_loading_detail"
                    style="@style/RecoveryMessage"
                    android:layout_marginTop="8dp" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@string/recovery_loading_progress"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recovery_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/recovery_alert_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/alert_icon_well"
                    android:importantForAccessibility="no"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recovery_alert_title"
                        style="@style/RecoveryTitle"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/recovery_alert_message"
                        style="@style/RecoveryMessage"
                        android:layout_marginTop="4dp"
                        android:gravity="start" />

                    <Button
                        android:id="@+id/recovery_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/button_surface"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:stateListAnimator="@null"
                        android:text="@string/recovery_retry"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
